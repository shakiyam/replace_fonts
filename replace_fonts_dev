#!/bin/bash
set -Eeu -o pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
readonly SCRIPT_DIR

if [[ -t 0 ]]; then
  TTY_FLAGS="-t"
else
  TTY_FLAGS=""
fi

if command -v docker &>/dev/null; then
  CONTAINER_ENGINE=docker
  ENGINE_OPTS=(-u "$(id -u):$(id -g)")
elif command -v podman &>/dev/null; then
  CONTAINER_ENGINE=podman
  ENGINE_OPTS=(--security-opt label=disable)
else
  echo 'Neither docker nor podman is installed.' >&2
  exit 1
fi
readonly CONTAINER_ENGINE
readonly ENGINE_OPTS

$CONTAINER_ENGINE container run \
  --name "replace_fonts_dev_$(uuidgen | head -c8)" \
  --rm \
  "${ENGINE_OPTS[@]}" \
  -i \
  $TTY_FLAGS \
  -v "$PWD":/work \
  -v "$SCRIPT_DIR"/apply_theme_fonts.py:/opt/replace_fonts/apply_theme_fonts.py:ro \
  -v "$SCRIPT_DIR"/define_theme_fonts.py:/opt/replace_fonts/define_theme_fonts.py:ro \
  -v "$SCRIPT_DIR"/logger.py:/opt/replace_fonts/logger.py:ro \
  -v "$SCRIPT_DIR"/replace_fonts.py:/opt/replace_fonts/replace_fonts.py:ro \
  ghcr.io/shakiyam/replace_fonts_dev "$@"
